[Unit]
Description=WVS web visualisation subsystem (gunicorn)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/webviz

# database login and the bits the header shows
Environment="WVS_DB_USER=webviz"
Environment="WVS_DB_PASS=webviz"
Environment="WVS_DB_NAME=wvs"
Environment="WVS_PAYLOAD_IP=192.168.4.21"
Environment="WVS_CADENCE=4.0"
Environment="WVS_DRILL_BAR=2.0"
# set to device to read a camera plugged into the pi instead
Environment="WVS_VIDEO_SOURCE=ingest"

ExecStart=/home/pi/webviz/venv/bin/gunicorn -c deploy/gunicorn_conf.py app:app
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
